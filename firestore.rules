rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /purchased_apps/{docId} {
      // Allow the website to check and create licenses
      // and allow the Android app to verify and bind device ID
      allow read: if true;

      // Allow creation from website
      allow create: if request.resource.data.app in ['Weddara', 'VowVault']
                    && request.resource.data.status == 'paid';

      // Allow the app to update ONLY if deviceId is not yet set
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId'])
                    && resource.data.deviceId == null;
    }
  }
}
