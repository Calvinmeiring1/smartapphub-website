rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for Licensing System
    match /purchased_apps/{docId} {
      allow read, write: if true;
    }

    // Public stats for website display
    match /stats/{docId} {
      allow read: if true;
    }

    // Legacy rules (if any)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
